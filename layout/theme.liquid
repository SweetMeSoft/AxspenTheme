{%- liquid
	# TEMPLATE
	assign template = template.name
	if template == 'account' or template == 'login' or template == 'register' or template == 'order' or template == 'addresses'
		assign account_details = ' has-account-details'
	endif

	# LANGUAGE
	assign is_rtl   = false
	assign language = request.locale.iso_code

	# List RTL language (ISO 639-1)
	assign rtl_languages = 'ar,he,fa,ur,yi,dv,ps,sd,ku,ug' | split: ','

	if rtl_languages contains language
		assign is_rtl = true
	endif

	assign locale_code = language | slice: 0, 2
	if rtl_languages contains locale_code
		assign is_rtl = true
	endif
-%}

<!doctype html>
<html class="no-js{% if is_rtl %} rtl{% endif %}" lang="{{ language }}">
	<head>
		{{- 'style.css' | asset_url | stylesheet_tag -}}
		{{ content_for_header }}

		{%- liquid
			render 'stylesheet'
			render 'meta'

			if is_rtl
				echo 'rtl.css' | asset_url | stylesheet_tag
			endif

			if request.page_type == 'policy'
				echo 'policy.css' | asset_url | stylesheet_tag
			endif
		-%}

	<script async src="https://api.buholabs.com/buho.js?id=pk_debfdab1d849254b89f118e5b036ebd1"></script>
	{%- if request.page_type == 'policy' -%}
		<script src="{{ 'policy.js' | asset_url }}" defer></script>
	{%- endif -%}

	</head>

	<body class="template-{{ template | default: request.page_type }}{{ account_details }}"{% if request.page_type == 'policy' %} data-policy="{{ request.path | split: '/' | last }}"{% endif %}>
		<a class="skip-to-content-link sr-only primary-button" href="#main-content">
			{{- 'accessibility.skip_to_text' | t -}}
		</a>

		<span class="loading-bar"></span>

		{%- liquid
			sections 'header-group'

			if settings.breadcrumb and template != '404' and template != 'index'
				section 'breadcrumb'
			endif
		-%}

		<main id="main-content" class="content-for-layout" role="main" tabindex="-1">
			{%- if request.page_type == 'policy' -%}
				<div class="policy-page-header">
					<div class="container">
						<nav class="policy-nav-tabs" aria-label="Políticas de la tienda">
							<a href="/policies/contact-information" class="policy-nav-tab{% if request.path contains 'contact-information' %} is-active{% endif %}">Contáctenos</a>
							<a href="/policies/shipping-policy" class="policy-nav-tab{% if request.path contains 'shipping-policy' %} is-active{% endif %}">Política De Envíos</a>
							<a href="/policies/refund-policy" class="policy-nav-tab{% if request.path contains 'refund-policy' %} is-active{% endif %}">Política De Cambio y Garantía</a>
							<a href="/policies/privacy-policy" class="policy-nav-tab{% if request.path contains 'privacy-policy' %} is-active{% endif %}">Políticas De Privacidad</a>
							<a href="/policies/terms-of-service" class="policy-nav-tab{% if request.path contains 'terms-of-service' %} is-active{% endif %}">Términos y Condiciones</a>
						</nav>
					</div>
				</div>
			{%- endif -%}

			{{ content_for_layout }}

			{%- if request.page_type == 'policy' -%}
				<div class="policy-page-footer">
					<div class="container">
						<div class="policy-footer-card">
							<div class="policy-footer-icon">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10"></circle>
									<path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
									<line x1="12" y1="17" x2="12.01" y2="17"></line>
								</svg>
							</div>
							<div class="policy-footer-text">
								<h4>¿Tienes alguna inquietud adicional?</h4>
								<p>Nuestro equipo de atención al cliente está disponible para asesorarte de lunes a sábado.</p>
							</div>
							<div class="policy-footer-actions">
								<a href="https://wa.me/+573046351159?text=Hola! Tengo una duda sobre las políticas de Axspen" target="_blank" rel="noopener noreferrer" class="policy-footer-btn policy-footer-btn-primary">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
										<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.044c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.164.576 4.195 1.584 5.952l-1.684 6.162 6.335-1.661c1.701.93 3.655 1.547 5.765 1.547 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
									</svg>
									Chat de Asesoría
								</a>
								<a href="{{ routes.root_url }}" class="policy-footer-btn policy-footer-btn-secondary">
									Volver a la Tienda
								</a>
							</div>
						</div>
					</div>
				</div>
			{%- endif -%}
		</main>

		{%- sections 'footer-group' -%}

		<div class="theme-component">
			{%- liquid
				echo '<div class="pickup-availability-panel"></div>'

				if shop.customer_accounts_enabled and customer == blank
					render 'popup-account'
				endif

				if settings.newsletter_popup
					section 'newsletter-popup'
				endif

		  		if settings.enabled_cookies_bar
		  			section 'cookies-bar'
		  		endif

				if settings.sticky_toolbar_mobile
					section 'sticky-toolbar-mobile'
				endif

				if template != 'cart'
					render 'side-cart'
				endif

				render 'popup-quick-view'
			-%}
		</div>

		<ul hidden>
			<li id="a11y-refresh-page-message">{{- 'accessibility.refresh_page' | t -}}</li>
		</ul>

		{% comment %}theme-check-disable{% endcomment %}
		{%- if settings.map_api != blank -%}
			<script src="//maps.googleapis.com/maps/api/js?key={{ settings.map_api }}&callback=btyGoogleMap" defer></script>
		{%- endif -%}
		{% comment %}theme-check-enable{% endcomment %}

		<script>
			window.btyGlobals = {
				money_format: '{%- if settings.currency_code_enabled -%}{{ shop.money_with_currency_format }}{%- else -%}{{ shop.money_format }}{%- endif -%}',
				search_url: '{{ routes.search_url }}',
				cart_url: '{{ routes.cart_url }}',
				cart_add_url: '{{ routes.cart_add_url }}.js',
				cart_change_url: '{{ routes.cart_change_url }}.js',
				cart_update_url: '{{ routes.cart_update_url }}.js',
				search_type: '{{ settings.search_type }}',
				search_unavailable: '{{ settings.search_unavailable_products }}',
				is_product: {% if request.page_type == 'product' %}{{ product.id }}{% else %}false{% endif %},
				last_product_id: {% if request.page_type == 'product' %}{{ product.id }}{% else %}false{% endif %},
				image_placeholder: '{%- render 'icon', code: 'placeholder' -%}',
				svg_tick: '{%- render 'icon', code: 'tick' -%}',
				svg_close_normal: '{%- render 'icon', code: 'close' -%}',
				svg_close: '{%- render 'icon', code: 'close-thin' -%}',
				svg_clock_history: '{%- render 'icon', code: 'clock-history' -%}',
				svg_warning: '{%- render 'icon', code: 'warning' -%}',
				card_placeholder: '{%- render 'card-placeholder' -%}'
			};

			window.btyStrings = {
				general: {
					share_success: "{{ 'general.share.success_message' | t }}"
				},
				cart: {
					error: "{{ 'sections.cart.cart_error' | t }}",
					quantity_error: "{{ 'sections.cart.cart_quantity_error_html' | t }}"
				},
				product: {
					regular_price: "{{ 'products.product.price.regular_price' | t }}",
					sale_price: "{{ 'products.product.price.sale_price' | t }}",
					add_to_cart: "{{ 'products.product.add_to_cart' | t }}",
					in_stock: "{{ 'products.product.in_stock' | t }}",
					sold_out: "{{ 'products.product.sold_out' | t }}",
					out_of_stock: "{{ 'products.product.out_of_stock' | t }}",
					unavailable: "{{ 'products.product.unavailable' | t }}",
					email_valid: "{{ 'recipient.form.email_valid' | t }}",
					recipient_message: "{{ 'recipient.form.message' | t }}",
					recipient_mail: "{{ 'recipient.form.email_label' | t }}",
					recipient_send_on: "{{ 'recipient.form.send_on_label' | t }}"
				}
			}
		</script>
	</body>
</html>
