      <div>
    {% assign coleccion_actual = product.collections.first %}

{% if coleccion_actual != blank %}
  <div id="productos-relacionados-mover" style="margin-top: 40px; padding: 40px 20px; background:#fff;">
    <h2 style="
      color:#003561; 
      text-align:center; 
      font-size: 28px; 
      font-weight: 800; 
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    ">
      También te puede interesar
    </h2>
    <div style="width: 60px; height: 3px; background:#C9A84C; margin: 0 auto 30px auto;"></div>

    <div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; max-width: 1200px; margin: 0 auto;">
      {% assign contador = 0 %}
      {% for producto_relacionado in coleccion_actual.products %}
        {% unless producto_relacionado.id == product.id %}
          {% if contador < 8 %}
            <a href="{{ producto_relacionado.url }}" style="text-decoration:none; color:inherit; width: 220px;">
              <div style="border: 1px solid #eee; border-radius: 8px; overflow: hidden; transition: box-shadow 0.2s;">
                <img 
                  src="{{ producto_relacionado.featured_image | image_url: width: 400 }}" 
                  alt="{{ producto_relacionado.title }}" 
                  style="width: 100%; height: 240px; object-fit: cover; display:block;"
                />
                <div style="padding: 12px; text-align:center;">
                  <p style="font-size: 14px; margin: 0 0 6px 0; color:#003561; font-weight:600;">
                    {{ producto_relacionado.title }}
                  </p>
                  <p style="font-size: 14px; margin: 0; color:#C9A84C; font-weight:700;">
                    {{ producto_relacionado.price | money }}
                  </p>
                </div>
              </div>
            </a>
            {% assign contador = contador | plus: 1 %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>
  </div>

  <script>
    (function() {
      var bloque = document.getElementById('productos-relacionados-mover');
      var seccionPrincipal = bloque.closest('section') || bloque.closest('[class*="section"]');
      if (bloque && seccionPrincipal) {
        seccionPrincipal.parentNode.insertBefore(bloque, seccionPrincipal.nextSibling);
      }
    })();
  </script>
{% endif %}
