{%- liquid
  assign cols_desktop = section.settings.columns_desktop | default: 5
  assign cols_tablet = section.settings.columns_tablet | default: 2
  assign cols_mobile = section.settings.columns_mobile | default: 3
  assign gap_desktop = section.settings.gap_desktop | default: 10
  assign gap_mobile = section.settings.gap_mobile | default: 5
-%}

<style>
  .ax-cat-carousel-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    margin: 1px auto 0;
    padding-top: {{ section.settings.padding_top | default: 8 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 8 }}px;
    overflow: hidden;
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__inner {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__viewport {
    width: 100%;
    overflow: hidden;
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__track {
    display: flex;
    flex-wrap: nowrap;
    column-gap: {{ gap_desktop }}px;
    will-change: transform;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__slide {
    flex: 0 0 calc((100% - ({{ cols_desktop }} - 1) * {{ gap_desktop }}px) / {{ cols_desktop }});
    min-width: calc((100% - ({{ cols_desktop }} - 1) * {{ gap_desktop }}px) / {{ cols_desktop }});
    max-width: calc((100% - ({{ cols_desktop }} - 1) * {{ gap_desktop }}px) / {{ cols_desktop }});
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__link {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    background-color: transparent;
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0, 0, 0, 1);
    -webkit-user-drag: none;
    user-select: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__link:hover .ax-cat-carousel__img {
      transform: scale(1.1);
    }
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    background: transparent;
    color: #000000;
    display: {% if section.settings.show_arrows_desktop %}flex{% else %}none{% endif %};
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__arrow--prev {
    left: 16px;
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__arrow--next {
    right: 16px;
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__arrow-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__arrow--prev .ax-cat-carousel__arrow-icon {
    transform: rotate(180deg);
  }
  .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__arrow-icon svg {
    width: 100%;
    height: 100%;
  }
  @media only screen and (max-width: 1024px) {
    .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__slide {
      flex: 0 0 calc((100% - ({{ cols_tablet }} - 1) * {{ gap_desktop }}px) / {{ cols_tablet }});
      min-width: calc((100% - ({{ cols_tablet }} - 1) * {{ gap_desktop }}px) / {{ cols_tablet }});
      max-width: calc((100% - ({{ cols_tablet }} - 1) * {{ gap_desktop }}px) / {{ cols_tablet }});
    }
  }
  @media only screen and (max-width: 767px) {
    .ax-cat-carousel-{{ section.id }} {
      margin-top: 5px;
      padding-top: {{ section.settings.padding_top_mobile | default: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 0 }}px;
    }
    .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__track {
      column-gap: {{ gap_mobile }}px;
    }
    .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__slide {
      flex: 0 0 calc((100% - ({{ cols_mobile }} - 1) * {{ gap_mobile }}px) / {{ cols_mobile }});
      min-width: calc((100% - ({{ cols_mobile }} - 1) * {{ gap_mobile }}px) / {{ cols_mobile }});
      max-width: calc((100% - ({{ cols_mobile }} - 1) * {{ gap_mobile }}px) / {{ cols_mobile }});
    }
    .ax-cat-carousel-{{ section.id }} .ax-cat-carousel__arrow {
      display: {% if section.settings.show_arrows_mobile %}flex{% else %}none{% endif %};
    }
  }
</style>

<section class="ax-cat-carousel-{{ section.id }}" data-ax-carousel="{{ section.id }}">
  <div class="ax-cat-carousel__inner">
    <button
      type="button"
      aria-label="Anterior"
      class="ax-cat-carousel__arrow ax-cat-carousel__arrow--prev"
      data-ax-prev
    >
      <span class="ax-cat-carousel__arrow-icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7.62204 5.13313C7.78476 4.95562 8.04858 4.95562 8.21129 5.13313L12.378 9.67859C12.5407 9.8561 12.5407 10.1439 12.378 10.3214L8.21129 14.8669C8.04858 15.0444 7.78476 15.0444 7.62204 14.8669C7.45932 14.6894 7.45932 14.4016 7.62204 14.224L11.4941 10L7.62204 5.77596C7.45932 5.59845 7.45932 5.31064 7.62204 5.13313Z"/>
        </svg>
      </span>
    </button>

    <div class="ax-cat-carousel__viewport">
      <div class="ax-cat-carousel__track" data-ax-track>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign img_src = block.settings.image_url
              if block.settings.image != blank
                assign img_src = block.settings.image | image_url: width: 1000
              endif
              assign slide_link = block.settings.link | default: '#'
              assign slide_alt = block.settings.title | default: block.settings.image.alt | default: ''
            -%}
            <div class="ax-cat-carousel__slide" {{ block.shopify_attributes }}>
              <a href="{{ slide_link }}" class="ax-cat-carousel__link" aria-label="{{ slide_alt | escape }}">
                <img
                  src="{{ img_src }}"
                  alt="{{ slide_alt | escape }}"
                  width="500"
                  height="600"
                  loading="lazy"
                  draggable="false"
                  class="ax-cat-carousel__img"
                >
              </a>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- assign fallback_items = "Jeans|https://cdn.shopify.com/s/files/1/0926/2350/3645/files/jd-cat-jeans.png?v=1793066391|/collections/jeans-mujer,Bodys|https://cdn.shopify.com/s/files/1/0926/2350/3645/files/jd-cat-bodys.png?v=1793066391|/collections/body,Blusas|https://cdn.shopify.com/s/files/1/0926/2350/3645/files/jd-cat-blusas.png?v=1793066391|/collections/blusas-y-camisas,Chaquetas|https://cdn.shopify.com/s/files/1/0926/2350/3645/files/jd-cat-chaquetas.png?v=1793066392|/collections/chaquetas-mujer,Buzos|https://cdn.shopify.com/s/files/1/0926/2350/3645/files/jd-cat-buzos.png?v=1793066391|/collections/sacos-y-buzos,Faldas|https://cdn.shopify.com/s/files/1/0926/2350/3645/files/jd-cat-faldas.png?v=1793066391|/collections/faldas,Blazer|https://cdn.shopify.com/s/files/1/0926/2350/3645/files/jd-cat-blazer.png?v=1793066391|/collections/trajes-blazer" | split: "," -%}
          {%- for raw_item in fallback_items -%}
            {%- assign parts = raw_item | split: "|" -%}
            <div class="ax-cat-carousel__slide">
              <a href="{{ parts[2] }}" class="ax-cat-carousel__link" aria-label="{{ parts[0] }}">
                <img
                  src="{{ parts[1] }}"
                  alt="{{ parts[0] }}"
                  width="500"
                  height="600"
                  loading="lazy"
                  draggable="false"
                  class="ax-cat-carousel__img"
                >
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <button
      type="button"
      aria-label="Siguiente"
      class="ax-cat-carousel__arrow ax-cat-carousel__arrow--next"
      data-ax-next
    >
      <span class="ax-cat-carousel__arrow-icon">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7.62204 5.13313C7.78476 4.95562 8.04858 4.95562 8.21129 5.13313L12.378 9.67859C12.5407 9.8561 12.5407 10.1439 12.378 10.3214L8.21129 14.8669C8.04858 15.0444 7.78476 15.0444 7.62204 14.8669C7.45932 14.6894 7.45932 14.4016 7.62204 14.224L11.4941 10L7.62204 5.77596C7.45932 5.59845 7.45932 5.31064 7.62204 5.13313Z"/>
        </svg>
      </span>
    </button>
  </div>
</section>

<script>
  (function () {
    const root = document.querySelector('[data-ax-carousel="{{ section.id }}"]');
    if (!root) return;
    const track = root.querySelector('[data-ax-track]');
    const prevBtn = root.querySelector('[data-ax-prev]');
    const nextBtn = root.querySelector('[data-ax-next]');
    if (!track || track.children.length < 2) return;

    let busy = false;
    let dragged = false;

    function getStep() {
      if (track.children.length < 2) return track.children[0].offsetWidth;
      return track.children[1].offsetLeft - track.children[0].offsetLeft;
    }

    function slideNext() {
      if (busy) return;
      busy = true;
      const step = getStep();
      track.style.transition = 'transform 500ms cubic-bezier(0.4, 0, 0.2, 1)';
      track.style.transform = 'translate3d(' + (-step) + 'px, 0, 0)';
      setTimeout(function () {
        track.style.transition = 'none';
        track.appendChild(track.firstElementChild);
        track.style.transform = 'translate3d(0, 0, 0)';
        busy = false;
      }, 510);
    }

    function slidePrev() {
      if (busy) return;
      busy = true;
      const step = getStep();
      track.style.transition = 'none';
      track.insertBefore(track.lastElementChild, track.firstElementChild);
      track.style.transform = 'translate3d(' + (-step) + 'px, 0, 0)';
      void track.offsetWidth;
      track.style.transition = 'transform 500ms cubic-bezier(0.4, 0, 0.2, 1)';
      track.style.transform = 'translate3d(0, 0, 0)';
      setTimeout(function () {
        track.style.transition = 'none';
        busy = false;
      }, 510);
    }

    if (nextBtn) nextBtn.addEventListener('click', slideNext);
    if (prevBtn) prevBtn.addEventListener('click', slidePrev);

    let startX = 0;
    let currentX = 0;
    let pointerActive = false;

    track.addEventListener('pointerdown', function (e) {
      if (busy || e.button > 0) return;
      pointerActive = true;
      dragged = false;
      startX = e.clientX;
      currentX = startX;
    });

    window.addEventListener('pointermove', function (e) {
      if (!pointerActive) return;
      currentX = e.clientX;
      if (Math.abs(currentX - startX) > 8) dragged = true;
    });

    window.addEventListener('pointerup', function () {
      if (!pointerActive) return;
      pointerActive = false;
      const dx = currentX - startX;
      if (dx < -35) slideNext();
      else if (dx > 35) slidePrev();
    });

    track.addEventListener('click', function (e) {
      if (dragged) {
        e.preventDefault();
        e.stopPropagation();
        dragged = false;
      }
    }, true);
  })();
</script>

{% schema %}
{
  "name": "Carrusel Categorías Home",
  "tag": "section",
  "class": "ax-category-carousel-section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columnas en tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columnas en móvil",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Espacio entre tarjetas (Escritorio)",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Espacio entre tarjetas (Móvil)",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows_desktop",
      "label": "Mostrar flechas en escritorio/tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Mostrar flechas en móvil",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Espacio superior (Móvil)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Espacio inferior (Móvil)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Categoría",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre de categoría",
          "default": "Categoría"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "URL de imagen (respaldo)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrusel Categorías Home"
    }
  ]
}
{% endschema %}
