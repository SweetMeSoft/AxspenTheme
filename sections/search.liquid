{%- liquid
	assign highlight = search.terms | split: ' AND ' | last | remove_first: '*'
-%}

<div class="fetch-search">
	{%- if search.performed -%}
		{%- if search.results_count > 0 -%}
			<div class="search-head">
				<h3 class="heading">{{- 'general.search.search_results' | t -}}</h3>
				<span class="products-found">{{- 'general.search.results_with_count' | t: count: search.results_count -}}</span>
			</div>

			<div class="main-content grid grid-4 grid-tablet-3 grid-mobile-2">
				{%- for item in search.results -%}
					<div class="grid-item">
						{%- liquid
							case item.object_type
								when 'product'
									render 'product-card', product: item, highlight: highlight
								when 'article'
									render 'post-card', article: item, in_search_results: true, highlight: highlight
								when 'page'
									render 'product-card', product: item, highlight: highlight
							endcase
						-%}
					</div>
				{%- endfor -%}
			</div>

			{%- if search.results_count > 4 -%}
				<div class="view-more-results">
					<a class="button primary-button" href="{{ routes.search_url }}?q={{ search.terms | escape }}&type={{ settings.search_type | default: 'product' }}&options[prefix]=last">
						{{- 'general.search.view_all_results' | t -}}
						{%- render 'icon', code: 'arrow-right-short' -%}
					</a>
				</div>
			{%- endif -%}
		{%- else -%}
			<p class="no-results" style="padding: 20px 0; color: #64748b; font-size: 1.1rem;">{{- 'general.search.no_results' | t -}}</p>
		{%- endif -%}
	{%- endif -%}
</div>

{% schema %}
{
	"name": "t:sections.main-search.name",
	"tag": "section",
	"class": "search-section"
}
{% endschema %}
