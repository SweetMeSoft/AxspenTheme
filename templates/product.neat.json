{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {
            "font_size": 30,
            "heading_font_weight": "700",
            "text_transform": "none",
            "padding_bottom": 8
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "font_size": 20,
            "padding_bottom": 16
          }
        },
        "variant": {
          "type": "variant-picker",
          "settings": {
            "picker_type": "swatch",
            "swatch_size": 44,
            "padding_bottom": 16
          }
        },
        "delivery": {
          "type": "custom-liquid",
          "settings": {
            "custom-liquid": "<div style=\"display:flex;align-items:center;gap:8px;font-size:14px;color:#555;margin:2px 0 4px;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg><span>Entrega estimada <strong>{{ 'now' | date: '%s' | plus: 259200 | date: '%b %d' }} &ndash; {{ 'now' | date: '%s' | plus: 518400 | date: '%b %d' }}</strong></span></div>",
            "padding_bottom": 12
          }
        },
        "atc": {
          "type": "add-to-cart",
          "settings": {
            "text_transform": "none",
            "quantity_selector": true,
            "dynamic_checkout": false,
            "show_gift_card": true,
            "padding_bottom": 16
          }
        },
        "pay": {
          "type": "custom-liquid",
          "settings": {
            "custom-liquid": "<div style=\"display:flex;gap:8px;align-items:center;justify-content:center;flex-wrap:wrap;margin:4px 0 8px;\"><img src=\"https://cdn.shopify.com/s/files/1/0926/2350/3645/files/ex.png\" alt=\"American Express\" style=\"height:24px;width:auto;\" loading=\"lazy\"><img src=\"https://cdn.shopify.com/s/files/1/0926/2350/3645/files/Visa.png\" alt=\"Visa\" style=\"height:24px;width:auto;\" loading=\"lazy\"><img src=\"https://cdn.shopify.com/s/files/1/0926/2350/3645/files/MasterCard.png\" alt=\"Mastercard\" style=\"height:24px;width:auto;\" loading=\"lazy\"><img src=\"https://cdn.shopify.com/s/files/1/0926/2350/3645/files/ApplePay.png\" alt=\"Apple Pay\" style=\"height:24px;width:auto;\" loading=\"lazy\"><img src=\"https://cdn.shopify.com/s/files/1/0926/2350/3645/files/Gpay.png\" alt=\"Google Pay\" style=\"height:24px;width:auto;\" loading=\"lazy\"></div>",
            "padding_bottom": 20
          }
        },
        "desc_tab": {
          "type": "custom-liquid",
          "settings": {
            "custom-liquid": "{%- if product.description != blank -%}<details class=\"native-desc-acc\" open style=\"border-top:1px solid #e5e5e5;\"><summary style=\"display:flex;justify-content:space-between;align-items:center;cursor:pointer;padding:16px 0;font-size:16px;font-weight:500;list-style:none;\">Descripción<span class=\"acc-plus\">+</span></summary><div style=\"padding:0 0 16px;font-size:15px;line-height:1.6;\">{{ product.description }}</div></details><style>.native-desc-acc summary::-webkit-details-marker{display:none;}.native-desc-acc[open] .acc-plus{transform:rotate(45deg);}.native-desc-acc .acc-plus{transition:transform .2s;font-size:20px;}</style>{%- endif -%}",
            "padding_bottom": 0
          }
        },
        "cambios_tab": {
          "type": "collapsible-tab",
          "settings": {
            "heading": "Cambios y Devoluciones",
            "heading_font_size": 16,
            "content": "<p><strong>DEVOLUCIÓN:</strong></p><p>Dispones de 30 días a partir de la fecha del envío del pedido.</p><p><strong>Devolución en domicilio</strong></p><p>Las devoluciones tienen un costo equivalente al valor del envío. Sin embargo, si el cambio o devolución se realiza por error de talla, color o defecto de fábrica, el costo lo asumimos nosotros.</p>",
            "content_font_size": 15,
            "icon": "return",
            "padding_bottom": 0
          }
        },
        "envios_tab": {
          "type": "collapsible-tab",
          "settings": {
            "heading": "Envíos",
            "heading_font_size": 16,
            "content": "<p><strong>ENVÍOS A BOGOTÁ</strong></p><p>En 2 - 4 días laborales $8.000 COP</p><p><strong>Envíos a otras ciudades de Colombia</strong></p><p>En 6 - 8 días laborales $15.000 COP</p>",
            "content_font_size": 15,
            "icon": "truck",
            "padding_bottom": 0
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant",
        "delivery",
        "atc",
        "pay",
        "desc_tab",
        "cambios_tab",
        "envios_tab"
      ],
      "settings": {
        "full": false,
        "color_scheme": "scheme-1",
        "space": 60,
        "sticky_add_to_cart": "hidden",
        "width": 50,
        "media_fit": "cover",
        "media_ratio": "portrait",
        "layout": "layout-3",
        "lightbox": true,
        "group_image": true,
        "show_thumbnail_images": true,
        "sticky_thumbnail_images": true,
        "sticky_content": true,
        "alignment": "left"
      }
    }
  },
  "order": ["main"]
}
