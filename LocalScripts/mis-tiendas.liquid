    function selectStore(id, panMap) {
      selectedStoreId = id;

      listEl.querySelectorAll(".axspen-store-card").forEach(c => {
        if (c.getAttribute("data-id") === id) {
          c.classList.add("is-active");
          c.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          c.classList.remove("is-active");
        }
      });

      Object.keys(markers).forEach(k => {
        const el = markers[k].getElement();
        if (el) {
          const iconDiv = el.querySelector(".axspen-marker-icon");
          if (iconDiv) {
            if (k === id) {
              iconDiv.classList.add("active");
            } else {
              iconDiv.classList.remove("active");
            }
          }
        }
      });

      if (panMap && map && markers[id]) {
        const store = STORES_DATA.find(s => s.id === id);
        if (store) {
          map.flyTo([store.lat, store.lng], 15, { duration: 1.2 });
          markers[id].openPopup();
        }
      }
    }

    function initMap() {
      if (typeof L === 'undefined') {
        setTimeout(initMap, 200);
        return;
      }

      map = L.map('axspenMasterMap', {
        center: [4.6500, -74.1200],
        zoom: 12,
        zoomControl: true,
        scrollWheelZoom: false
      });

      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 19
      }).addTo(map);

      STORES_DATA.forEach(store => {
        const queryEnc = encodeURIComponent(`${store.name} ${store.address} ${store.city} Colombia`);
        const gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${queryEnc}`;
        const wazeUrl = `https://waze.com/ul?q=${queryEnc}&navigate=yes`;

        const pinHtml = `
          <div class="axspen-marker-icon" id="marker-${store.id}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
          </div>
        `;

        const customIcon = L.divIcon({
          className: 'axspen-pin-wrap',
          html: pinHtml,
          iconSize: [38, 38],
          iconAnchor: [19, 38],
          popupAnchor: [0, -38]
        });

        const popupContent = `
          <div class="axspen-popup-body">
            <span class="axspen-popup-city">${store.city} · ${store.zone}</span>
            <h4>${store.name}</h4>
            <p class="axspen-popup-address">${store.address}</p>
            <div class="axspen-popup-actions">
              <a href="${gmapsUrl}" target="_blank" rel="noopener noreferrer" class="axspen-popup-btn axspen-btn-dark">
                Google Maps
              </a>
              <a href="${wazeUrl}" target="_blank" rel="noopener noreferrer" class="axspen-popup-btn axspen-btn-waze">
                Waze
              </a>
            </div>
          </div>
        `;

        const marker = L.marker([store.lat, store.lng], { icon: customIcon }).addTo(map);
        marker.bindPopup(popupContent);

        marker.on('click', function() {
          selectStore(store.id, false);
        });

        markers[store.id] = marker;
      });
    }

    function handleGeolocation() {
      if (!navigator.geolocation) {
        alert("La geolocalización no es compatible con tu navegador.");
        return;
      }

      geoBtnLabel.textContent = "Buscando...";
      geoBtn.classList.add("active");

      navigator.geolocation.getCurrentPosition(
        position => {
          const lat = position.coords.latitude;
          const lon = position.coords.longitude;
          userLocation = { lat, lon };

          geoBtnLabel.textContent = "Más cercanas";
          geoStatus.style.display = "inline-block";

          storesList.forEach(s => {
            s.distance = calculateDistance(lat, lon, s.lat, s.lng);
          });
          storesList.sort((a, b) => a.distance - b.distance);

          renderCards();

          if (storesList.length > 0) {
            selectStore(storesList[0].id, true);
          }
        },
        error => {
          geoBtnLabel.textContent = "Cerca de mí";
          geoBtn.classList.remove("active");
          alert("No pudimos acceder a tu ubicación. Por favor habilita los permisos en tu navegador.");
        },
        { enableHighAccuracy: true, timeout: 8000 }
      );
    }

    if (searchInput) {
      searchInput.addEventListener("input", function(e) {
        searchQuery = e.target.value.toLowerCase().trim();
        clearSearchBtn.style.display = searchQuery ? "flex" : "none";
        renderCards();
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener("click", function() {
        searchInput.value = "";
        searchQuery = "";
        clearSearchBtn.style.display = "none";
        renderCards();
        searchInput.focus();
      });
    }

    if (resetSearchBtn) {
      resetSearchBtn.addEventListener("click", function() {
        searchInput.value = "";
        searchQuery = "";
        activeFilter = "all";
        filterPills.forEach(p => p.classList.toggle("active", p.getAttribute("data-filter") === "all"));
        renderCards();
      });
    }

    filterPills.forEach(pill => {
      pill.addEventListener("click", function() {
        filterPills.forEach(p => p.classList.remove("active"));
        this.classList.add("active");
        activeFilter = this.getAttribute("data-filter");
        renderCards();
      });
    });

    if (geoBtn) {
      geoBtn.addEventListener("click", handleGeolocation);
    }

    if (btnSwitchList && btnSwitchMap) {
      btnSwitchList.addEventListener("click", function() {
        btnSwitchList.classList.add("active");
        btnSwitchList.setAttribute("aria-selected", "true");
        btnSwitchMap.classList.remove("active");
        btnSwitchMap.setAttribute("aria-selected", "false");

        panelEl.classList.remove("is-map-view");
        panelEl.classList.add("is-list-view");
        mapContainerEl.classList.remove("is-map-view");
        mapContainerEl.classList.add("is-list-view");
      });

      btnSwitchMap.addEventListener("click", function() {
        btnSwitchMap.classList.add("active");
        btnSwitchMap.setAttribute("aria-selected", "true");
        btnSwitchList.classList.remove("active");
        btnSwitchList.setAttribute("aria-selected", "false");

        panelEl.classList.remove("is-list-view");
        panelEl.classList.add("is-map-view");
        mapContainerEl.classList.remove("is-list-view");
        mapContainerEl.classList.add("is-map-view");

        if (map) {
          setTimeout(() => {
            map.invalidateSize();
            if (selectedStoreId && STORES_DATA.find(s => s.id === selectedStoreId)) {
              const s = STORES_DATA.find(s => s.id === selectedStoreId);
              map.setView([s.lat, s.lng], 14);
            }
          }, 200);
        }
      });
    }

    renderCards();
    initMap();

  })();
</script>
