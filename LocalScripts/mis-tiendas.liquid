      listEl.querySelectorAll(".axspen-copy-btn").forEach(btn => {
        btn.addEventListener("click", function(e) {
          e.stopPropagation();
          const text = this.getAttribute("data-copy");
          const label = this.querySelector(".copy-label");
          if (navigator.clipboard && text) {
            navigator.clipboard.writeText(text).then(() => {
              const orig = label ? label.textContent : "Copiar";
              if (label) label.textContent = "¡Copiado!";
              this.style.background = "#ecfdf5";
              this.style.borderColor = "#6ee7b7";
              this.style.color = "#065f46";
              setTimeout(() => {
                if (label) label.textContent = orig;
                this.style.background = "";
                this.style.borderColor = "";
                this.style.color = "";
              }, 1800);
            });
