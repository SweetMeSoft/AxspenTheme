{% comment %}
  Plantilla: Mis Tiendas Axspen (Split-Screen Flagship Locator)
  Compatible con Páginas, Snippets y Bloques HTML/Liquid de Shopify.
{% endcomment %}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<div class="axspen-stores-scope">
  <!-- Header -->
  <header class="axspen-stores-header">
    <div class="axspen-stores-badge">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
      <span>Puntos Físicos</span>
    </div>
    <h1 class="axspen-stores-title">Nuestras Tiendas</h1>
    <p class="axspen-stores-subtitle">Encuentra tu punto físico más cercano, visítanos y vive la experiencia Axspen en denim.</p>
  </header>

  <!-- Split Screen Container -->
  <div class="axspen-stores-split">
    
    <!-- Left: Controls & Store Cards -->
    <div class="axspen-stores-panel is-list-view" id="axspenStoresPanel">
      
      <!-- Mobile Switcher (Tab buttons) -->
      <div class="axspen-mobile-switcher" role="tablist">
        <button type="button" class="axspen-switch-btn active" id="btnSwitchList" role="tab" aria-selected="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
          <span>Lista de Tiendas</span>
        </button>
        <button type="button" class="axspen-switch-btn" id="btnSwitchMap" role="tab" aria-selected="false">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          <span>Ver Mapa</span>
        </button>
      </div>

      <!-- Controls Area -->
      <div class="axspen-controls-area">
        <!-- Search input -->
        <div class="axspen-search-wrap">
          <svg class="axspen-search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input 
            type="text" 
            id="axspenSearchInput" 
            class="axspen-search-input" 
            placeholder="Buscar por tienda, centro comercial, barrio..." 
            aria-label="Buscar tienda física"
          />
          <button type="button" id="axspenClearSearch" class="axspen-clear-btn" aria-label="Limpiar búsqueda" style="display: none;">
            &times;
          </button>
        </div>

        <!-- Filter Pills -->
        <div class="axspen-filter-pills" id="axspenFilterPills">
          <button type="button" class="axspen-pill-btn active" data-filter="all">Todas</button>
          <button type="button" class="axspen-pill-btn axspen-geo-pill" id="axspenGeoBtn">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span id="geoBtnLabel">Cerca de mí</span>
          </button>
          <button type="button" class="axspen-pill-btn" data-filter="mall">Centros Comerciales</button>
          <button type="button" class="axspen-pill-btn" data-filter="bogota">Bogotá</button>
          <button type="button" class="axspen-pill-btn" data-filter="soacha">Soacha</button>
        </div>

        <!-- Meta status line -->
        <div class="axspen-stores-meta">
          <span id="axspenCounterText">Mostrando <strong>11</strong> tiendas</span>
          <span id="axspenGeoStatus" style="display: none; color: #1d4ed8; font-weight: 600;">⚡ Ordenadas por cercanía</span>
        </div>
      </div>

      <!-- Scrollable Store Cards Feed -->
      <div class="axspen-stores-list" id="axspenStoresList" role="list">
        <!-- Injected dynamically via JS -->
      </div>

      <!-- Empty state when no stores found -->
      <div class="axspen-no-results" id="axspenNoResults" style="display: none;">
        <p>No encontramos tiendas que coincidan con tu búsqueda.</p>
        <button type="button" class="axspen-btn axspen-btn-dark" id="axspenResetSearchBtn">Ver todas las tiendas</button>
      </div>

    </div>

    <!-- Right: Master Sticky Interactive Map -->
    <div class="axspen-map-container is-list-view" id="axspenMapContainer">
      <div id="axspenMasterMap"></div>
    </div>

  </div>
</div>

<style>
  .axspen-stores-scope {
    width: 100%;
    max-width: 1540px;
    margin: 0 auto;
    padding: 40px 16px 80px;
    box-sizing: border-box;
    color: #0f172a;
    font-family: inherit;
  }

  /* Header Section */
  .axspen-stores-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 36px;
  }
  .axspen-stores-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0f172a;
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 6px 14px;
    border-radius: 9999px;
    margin-bottom: 14px;
  }
  .axspen-stores-badge svg {
    width: 14px;
    height: 14px;
  }
  .axspen-stores-title {
    font-size: 3.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #0f172a;
    margin: 0 0 12px;
  }
  .axspen-stores-subtitle {
    font-size: 1.6rem;
    line-height: 1.5;
    color: #475569;
    margin: 0 auto;
    max-width: 600px;
  }

  /* Split Layout Container */
  .axspen-stores-split {
    display: flex;
    flex-direction: column;
    gap: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    background: #f8fafc;
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.05);
  }
  @media (min-width: 992px) {
    .axspen-stores-split {
      flex-direction: row;
      height: 780px;
      gap: 0;
    }
  }

  /* Mobile View Switcher */
  .axspen-mobile-switcher {
    display: flex;
    background: #e2e8f0;
    border-radius: 12px;
    padding: 4px;
    margin-bottom: 16px;
    gap: 4px;
  }
  @media (min-width: 992px) {
    .axspen-mobile-switcher {
      display: none;
    }
  }
  .axspen-switch-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 14px;
    font-size: 1.4rem;
    font-weight: 700;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .axspen-switch-btn.active {
    background: #0f172a;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
  }
  .axspen-switch-btn svg {
    width: 16px;
    height: 16px;
  }

  /* Left Panel: Filters & List */
  .axspen-stores-panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 20px;
    box-sizing: border-box;
    background: #ffffff;
  }
  @media (min-width: 992px) {
    .axspen-stores-panel {
      width: 45%;
      border-right: 1px solid #e2e8f0;
      height: 100%;
      padding: 28px 24px;
    }
  }

  /* Search & Filter Bar */
  .axspen-controls-area {
    margin-bottom: 18px;
  }
  .axspen-search-wrap {
    position: relative;
    width: 100%;
    margin-bottom: 14px;
  }
  .axspen-search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: #64748b;
    pointer-events: none;
  }
  .axspen-search-input {
    width: 100%;
    padding: 14px 44px 14px 46px;
    border-radius: 12px;
    border: 1.5px solid #cbd5e1;
    font-size: 1.5rem;
    background: #f8fafc;
    color: #0f172a;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .axspen-search-input:focus {
    border-color: #0f172a;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.08);
  }
  .axspen-clear-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: #e2e8f0;
    border: none;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    line-height: 1;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s;
  }
  .axspen-clear-btn:hover {
    background: #cbd5e1;
    color: #0f172a;
  }

  /* Filter Pills */
  .axspen-filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .axspen-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #e2e8f0;
    padding: 7px 13px;
    border-radius: 8px;
    font-size: 1.3rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .axspen-pill-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
    border-color: #cbd5e1;
  }
  .axspen-pill-btn.active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }
  .axspen-geo-pill {
    background: #eff6ff;
    color: #1d4ed8;
    border-color: #bfdbfe;
  }
  .axspen-geo-pill:hover {
    background: #dbeafe;
    border-color: #93c5fd;
    color: #1e40af;
  }
  .axspen-geo-pill.active {
    background: #1d4ed8;
    color: #ffffff;
    border-color: #1d4ed8;
  }
  .axspen-geo-pill svg {
    width: 14px;
    height: 14px;
  }

  /* Stores Status Counter */
  .axspen-stores-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.3rem;
    color: #64748b;
    padding-bottom: 10px;
    border-bottom: 1px solid #f1f5f9;
  }
  .axspen-stores-meta strong {
    color: #0f172a;
  }

  /* Stores List (Scrollable) */
  .axspen-stores-list {
    flex: 1;
    overflow-y: auto;
    padding-right: 6px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 10px;
  }
  .axspen-stores-list::-webkit-scrollbar {
    width: 5px;
  }
  .axspen-stores-list::-webkit-scrollbar-track {
    background: #f8fafc;
  }
  .axspen-stores-list::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }

  /* Individual Store Card */
  .axspen-store-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    padding: 18px 20px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    box-sizing: border-box;
  }
  .axspen-store-card:hover {
    border-color: #94a3b8;
    box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.08);
    transform: translateY(-2px);
  }
  .axspen-store-card.is-active {
    border-color: #0f172a;
    background: #f8fafc;
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.12);
  }
  .axspen-store-card.is-active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 4px;
    background: #0f172a;
    border-radius: 0 4px 4px 0;
  }

  /* Card Header */
  .axspen-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .axspen-badges-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .axspen-tag-city {
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: #f1f5f9;
    color: #475569;
    padding: 3px 8px;
    border-radius: 6px;
  }
  .axspen-tag-type {
    font-size: 1.15rem;
    font-weight: 600;
    background: #f8fafc;
    color: #64748b;
    border: 1px solid #e2e8f0;
    padding: 2px 7px;
    border-radius: 6px;
  }
  .axspen-tag-distance {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1d4ed8;
    background: #eff6ff;
    padding: 3px 8px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Live Status Pill */
  .axspen-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 1.15rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 9999px;
    white-space: nowrap;
  }
  .axspen-status-pill.open {
    background: #ecfdf5;
    color: #065f46;
  }
  .axspen-status-pill.closed {
    background: #f1f5f9;
    color: #64748b;
  }
  .axspen-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .axspen-status-pill.open .axspen-status-dot {
    background: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
  }
  .axspen-status-pill.closed .axspen-status-dot {
    background: #94a3b8;
  }

  /* Card Name & Address */
  .axspen-card-name {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 6px;
    line-height: 1.3;
  }
  .axspen-card-address-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 1.35rem;
    color: #334155;
    line-height: 1.45;
    margin-bottom: 12px;
  }
  .axspen-card-address-row svg {
    width: 16px;
    height: 16px;
    min-width: 16px;
    margin-top: 2px;
    color: #0f172a;
  }

  /* Hours Drawer / Text */
  .axspen-hours-summary {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1.25rem;
    color: #64748b;
    margin-bottom: 14px;
    background: #f8fafc;
    padding: 6px 10px;
    border-radius: 8px;
    border: 1px dashed #cbd5e1;
  }
  .axspen-hours-summary svg {
    width: 14px;
    height: 14px;
    color: #64748b;
  }

  /* Card Action Buttons */
  .axspen-card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }
  .axspen-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 1.25rem;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    box-sizing: border-box;
    line-height: 1;
    border: 1px solid transparent;
  }
  .axspen-btn-dark {
    background: #0f172a;
    color: #ffffff !important;
  }
  .axspen-btn-dark:hover {
    background: #334155;
    transform: translateY(-1px);
  }
  .axspen-btn-waze {
    background: #33ccff;
    color: #0f172a !important;
    font-weight: 700;
  }
  .axspen-btn-waze:hover {
    background: #2bb8e6;
    transform: translateY(-1px);
  }
  .axspen-btn-whatsapp {
    background: #25d366;
    color: #ffffff !important;
    font-weight: 700;
  }
  .axspen-btn-whatsapp:hover {
    background: #20ba59;
    transform: translateY(-1px);
  }
  .axspen-btn-outline {
    background: #ffffff;
    color: #334155;
    border-color: #cbd5e1;
  }
  .axspen-btn-outline:hover {
    background: #f1f5f9;
    color: #0f172a;
    border-color: #94a3b8;
  }
  .axspen-btn svg {
    width: 14px;
    height: 14px;
    min-width: 14px;
  }

  /* Right Panel: Master Map */
  .axspen-map-container {
    width: 100%;
    height: 480px;
    position: relative;
    background: #e2e8f0;
  }
  @media (min-width: 992px) {
    .axspen-map-container {
      width: 55%;
      height: 100%;
    }
  }
  #axspenMasterMap {
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* Custom Leaflet Pins */
  .axspen-pin-wrap {
    background: none;
    border: none;
  }
  .axspen-marker-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #0f172a;
    color: #ffffff;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.35);
    border: 2px solid #ffffff;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }
  .axspen-marker-icon svg {
    width: 18px;
    height: 18px;
    transform: rotate(45deg);
    fill: none;
    stroke: #ffffff;
  }
  .axspen-marker-icon.active,
  .axspen-marker-icon:hover {
    transform: rotate(-45deg) scale(1.22);
    background: #000000;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.5);
    border-color: #38bdf8;
  }

  /* Leaflet Popup Styling */
  .leaflet-popup-content-wrapper {
    border-radius: 14px !important;
    padding: 6px !important;
    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.18) !important;
    border: 1px solid #e2e8f0 !important;
    font-family: inherit !important;
  }
  .leaflet-popup-content {
    margin: 12px 14px !important;
    line-height: 1.4 !important;
  }
  .axspen-popup-body h4 {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 4px;
  }
  .axspen-popup-city {
    display: inline-block;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #475569;
    background: #f1f5f9;
    padding: 2px 6px;
    border-radius: 4px;
    margin-bottom: 6px;
  }
  .axspen-popup-address {
    font-size: 1.3rem;
    color: #334155;
    margin: 0 0 10px;
  }
  .axspen-popup-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .axspen-popup-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 1.15rem;
    font-weight: 600;
    padding: 6px 10px;
    border-radius: 6px;
    text-decoration: none;
    line-height: 1;
  }

  /* Empty State */
  .axspen-no-results {
    text-align: center;
    padding: 50px 20px;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px dashed #cbd5e1;
    margin-top: 20px;
  }
  .axspen-no-results p {
    font-size: 1.45rem;
    color: #64748b;
    margin: 0 0 14px;
  }

  /* Responsive Behavior */
  @media (max-width: 991px) {
    .axspen-stores-title {
      font-size: 2.6rem;
    }
    .axspen-stores-subtitle {
      font-size: 1.4rem;
    }
    .axspen-stores-panel.is-map-view {
      display: none;
    }
    .axspen-map-container.is-list-view {
      display: none;
    }
    .axspen-map-container.is-map-view {
      display: block;
      height: 580px;
    }
  }
</style>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
  (function() {
    const STORES_DATA = [
