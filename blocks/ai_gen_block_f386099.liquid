      "id": "email_label",
      "label": "Etiqueta de correo",
      "default": "Correo electrónico"
    },
    {
      "type": "inline_richtext",
      "id": "rating_label",
      "label": "Etiqueta de calificación",
      "default": "Calificación"
    },
    {
      "type": "inline_richtext",
      "id": "title_label",
      "label": "Etiqueta de título",
      "default": "Título de la reseña"
    },
    {
      "type": "inline_richtext",
      "id": "message_label",
