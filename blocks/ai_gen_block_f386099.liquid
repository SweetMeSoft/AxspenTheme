    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Radio del borde del botón",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colores"
