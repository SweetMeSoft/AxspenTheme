      "default": "#fdc643"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Botón",
      "default": "#232020"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texto del botón",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Botón al pasar el cursor",
      "default": "#000000"
